# Copy this file to `.env.local` and fill in real values.
#
# Every variable here is NEXT_PUBLIC_* deliberately — this project never
# holds a secret. Sign-in goes through Supabase Auth directly (the anon key
# below is safe to ship to the browser, same as every other ProdBnb client);
# every privileged read/write goes through the ProdBnb backend's own
# authenticated /v1/admin/* API, never Supabase or Cashfree directly.

# Same Supabase project as the ProdBnb backend and iOS app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# The ProdBnb backend's own base URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
