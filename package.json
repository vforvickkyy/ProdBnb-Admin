{
  "name": "prodbnb-admin",
  "version": "0.1.0",
  "private": true,
  "description": "ProdBnb Admin Panel — a separate frontend project that consumes the ProdBnb backend's /v1/admin/* API. Never holds Supabase service-role, Cashfree, APNs, or R2 secrets.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "openapi-typescript ../ProdBnb\\ Backend/docs/admin-openapi.json -o src/types/admin-api.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^15.0.0",
    "openapi-fetch": "^0.13.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.4.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
